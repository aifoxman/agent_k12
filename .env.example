# Generate a long random value before exposing the API beyond localhost.
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=./data/homework.sqlite3
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://appassets.androidplatform.net
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# Fast vision checks (setup, same-page comparison, visible new work); leave empty to use AI_MODEL.
AI_FAST_VISION_MODEL=gpt-6-luna
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=
# Optional local transcription after: uv sync --extra asr; uv run --extra asr scripts/prepare-local-asr.py
ASR_LOCAL_MODEL_PATH=
# Select the TTS provider on the API server. Tencent credentials stay off the Pad.
TTS_PROVIDER=tencent
# application (default): family trial limit; provider: use the configured cloud account resources.
# Provider mode retains family consent and usage history; it does not expose a cloud balance.
TTS_QUOTA_MODE=application
TENCENT_TTS_APP_ID=
TENCENT_TTS_SECRET_ID=
TENCENT_TTS_SECRET_KEY=
# Super-natural large-model voice -> large-model speech -> general speech.
TENCENT_TTS_VOICE_TYPE=502001
# Only resource exhaustion before any audio permits trying the next configured voice.
TENCENT_TTS_FALLBACK_VOICE_TYPES=501002,101001
# Existing Aliyun option: set TTS_PROVIDER=aliyun and configure both values.
TTS_API_KEY=
TTS_WORKSPACE_ID=
AI_TIMEOUT_SECONDS=120
CORRECTION_TIMEOUT_SECONDS=240
# Require parent approval for child grading. Set false only on a test API, then restart it.
CORRECTION_REQUIRE_PARENT_APPROVAL=true
TURN_HOST=
TURN_SHARED_SECRET=
TURN_PORT=3478
APP_DOMAIN=api.example.com
TURN_PUBLIC_IP=
